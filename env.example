# Copy to .env. Never commit .env.
# Everything in .env is passed to the notifier container (compose.yml: env_file),
# so only the NOTIFIER section belongs here. See the last section for the rest.

# ── NOTIFIER: GitLab ────────────────────────────────────────────────────────
# GitLab user ID of the Renovate bot. Only MRs authored by this user notify.
# Find it: GitLab > the bot's profile, or GET /api/v4/user with the bot's token.
RENOVATE_AUTHOR_ID=12345

# Webhook credential: set exactly ONE of the two below.
# A) GitLab CE 15.11.x and other versions without signing tokens:
#    Secret token in Settings > Webhooks. Generate: openssl rand -hex 32
GITLAB_WEBHOOK_SECRET=replace-with-a-random-secret
# B) GitLab 19.1+: comment out the secret above and use GitLab's
#    "Generate signing token" value (must start with whsec_).
# GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace-with-token-from-gitlab

# ── NOTIFIER: channels ──────────────────────────────────────────────────────
# Enable Telegram, Slack, or both. At least one is required.
# Telegram needs BOTH token and chat id, or neither.
TELEGRAM_BOT_TOKEN=123456:replace-with-real-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# Optional: forum topic ID inside the chat.
# TELEGRAM_MESSAGE_THREAD_ID=123
# Optional: internal proxy for the Telegram API (default https://api.telegram.org).
# TELEGRAM_API_BASE=https://api.telegram.org

# Slack incoming webhook. Must be https://.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-with-real-webhook

# ── NOTIFIER: optional ──────────────────────────────────────────────────────
# The sent-MR history is notified.sqlite3 in the working directory (/data in Docker).
# Simulate a reopen notification for one MR without a severity, format
# project_id:iid. Leave unset in normal use.
# REOPEN_TEST_MR=316:588

# ── NOT for the notifier: Renovate and webhook sync ─────────────────────────
# Set these as GitLab CI/CD variables (RENOVATE_*) or export them in your shell
# for scripts/sync_webhooks.py. Do not put the admin token in the notifier .env.
#
# RENOVATE_TEST_REPOSITORY       TESTING: one project path, e.g. frontend/dashboard.
#                                When set, Renovate and sync_webhooks.py touch only
#                                this project and ignore RENOVATE_TARGET_REPOSITORIES.
#                                Unset it to go live.
RENOVATE_TEST_REPOSITORY=
# RENOVATE_TARGET_REPOSITORIES   GitLab GROUP names, comma/newline-separated. Renovate
#                                runs on every active project inside each group,
#                                subgroups included. Read by config.js and
#                                sync_webhooks.py. Add a repo = nothing to change;
#                                add a group = append its name.
#   e.g. RENOVATE_TARGET_REPOSITORIES=frontend,backend
#   subgroup: RENOVATE_TARGET_REPOSITORIES=frontend,backend,platform/web
# RENOVATE_TOKEN                 GitLab token for Renovate (CI/CD variable)
# GITHUB_COM_TOKEN               optional, avoids GitHub API rate limits in release notes
#
# Only for scripts/sync_webhooks.py (it supports GITLAB_WEBHOOK_SECRET only):
# CI_API_V4_URL                  e.g. https://gitlab.example.com/api/v4
# GITLAB_WEBHOOK_ADMIN_TOKEN     token with Maintainer access to every project in the groups
# NOTIFIER_WEBHOOK_URL           public HTTPS URL ending in /webhook
# GITLAB_WEBHOOK_SECRET          same value as above
