# Place this server block in Nginx on the notifier host.
# Replace the hostname and TLS certificate paths.
server {
    listen 443 ssl;
    server_name renovate-notify.example.internal;
    ssl_certificate /etc/ssl/certs/renovate-notify.crt;
    ssl_certificate_key /etc/ssl/private/renovate-notify.key;

    location /webhook {
        client_max_body_size 1m;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:8080;
    }

    location /healthz {
        proxy_pass http://127.0.0.1:8080;
    }
}
