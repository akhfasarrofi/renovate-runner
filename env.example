# Quick start:  cp env.example .env   then fill in the REQUIRED block. Never commit .env.
# Plain KEY=value, no quotes. Lines starting with # are ignored.
#
# This file is passed whole to the notifier container (compose.yml: env_file),
# so it holds only notifier settings. Renovate and webhook-sync variables live
# elsewhere: see the last section.

# ════════════════════════════════════════════════════════════════════════════
# REQUIRED
# ════════════════════════════════════════════════════════════════════════════

# Platform: gitlab (default), github, or bitbucket (Bitbucket Cloud).
RENOVATE_PLATFORM=gitlab

# Renovate bot identity. Only MRs/PRs authored by it send a notification.
#   gitlab:    numeric user ID of the bot
#              curl -s -H "PRIVATE-TOKEN: <bot token>" https://gitlab.example.com/api/v4/user | jq .id
#   github:    login, e.g. renovate[bot] (GitHub App) or your bot user's login
#   bitbucket: uuid with braces, or account_id (GET https://api.bitbucket.org/2.0/user)
RENOVATE_AUTHOR=12345

# Webhook secret. Enter the SAME value in the webhook settings of your platform.
# Generate one: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-random-secret
# GitLab 19.1+ only: use the signing token (whsec_...) INSTEAD of WEBHOOK_SECRET
# (set one, not both). Then comment out WEBHOOK_SECRET above.
# GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace-with-token-from-gitlab

# At least one channel is required: Telegram, Slack, or both.
# Telegram needs BOTH token and chat id, or neither.
TELEGRAM_BOT_TOKEN=123456:replace-with-real-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# Slack incoming webhook (must be https://):
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-with-real-webhook

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL (defaults are fine for most setups)
# ════════════════════════════════════════════════════════════════════════════

# Message language: en (default) or id.
# NOTIFY_LANG=en

# Telegram forum topic ID inside the chat.
# TELEGRAM_MESSAGE_THREAD_ID=123

# Testing only: replay a reopen notification for one MR/PR, format repo_id:iid
# (GitLab project ID or GitHub repository ID). Leave unset in normal use.
# REOPEN_TEST_MR=316:588

# ════════════════════════════════════════════════════════════════════════════
# NOT FOR THIS FILE. Keep these commented out; set them where noted.
# ════════════════════════════════════════════════════════════════════════════
#
# A) Renovate job. Set as CI/CD variables (GitLab), Actions secrets/variables
#    (GitHub) or repository variables (Bitbucket):
#
#    RENOVATE_TOKEN                 REQUIRED. Token of the Renovate bot.
#                                   Bitbucket: use RENOVATE_USERNAME (Atlassian
#                                   email) + RENOVATE_PASSWORD (API token) instead.
#    RENOVATE_TARGET_REPOSITORY     REQUIRED. Comma or newline separated, either:
#                                   - project paths: frontend/app1,frontend/app2
#                                   - groups (GitLab group / GitHub org or user /
#                                     Bitbucket workspace): frontend,backend
#                                     runs on every active project inside.
#                                   Do not mix the two. A path with "/" is always a
#                                   project, so a GitLab subgroup cannot be a group.
#    GITHUB_COM_TOKEN               Optional. Avoids GitHub rate limits when
#                                   fetching release notes.
#
# B) scripts/sync_webhooks.py (GitLab only). Export in your shell, not here, and
#    never put the admin token in the notifier .env:
#
#    CI_API_V4_URL                  e.g. https://gitlab.example.com/api/v4
#    GITLAB_WEBHOOK_ADMIN_TOKEN     Maintainer access to every project in the groups
#    NOTIFIER_WEBHOOK_URL           public HTTPS URL ending in /renovate/webhook
#    WEBHOOK_SECRET                 same value as above
#    RENOVATE_TARGET_REPOSITORY     as in A
#
#    GitHub and Bitbucket: create one organization/workspace webhook by hand (see README).
