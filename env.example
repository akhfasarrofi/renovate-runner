# Copy to .env. Never commit .env.
# Everything in .env is passed to the notifier container (compose.yml: env_file),
# so only the NOTIFIER section belongs here. See the last section for the rest.

# ── NOTIFIER: platform ──────────────────────────────────────────────────────
# Where the repositories live: gitlab (default), github or bitbucket (Bitbucket Cloud).
# Renovate itself reads the same RENOVATE_PLATFORM variable.
RENOVATE_PLATFORM=gitlab

# Identity of the Renovate bot. Only MRs/PRs authored by it notify.
#   gitlab:    numeric user ID (GET /api/v4/user with the bot's token)
#   github:    login, e.g. renovate[bot] (GitHub App) or your bot user's login
#   bitbucket: uuid (with braces) or account_id of the bot (GET /2.0/user)
# The old name RENOVATE_AUTHOR_ID still works.
RENOVATE_AUTHOR=12345

# Webhook secret, the same value you enter in the webhook settings.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-random-secret
# GitLab 19.1+ only: use the signing token (whsec_...) instead of WEBHOOK_SECRET.
# GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace-with-token-from-gitlab
# GITLAB_WEBHOOK_SECRET is the old name of WEBHOOK_SECRET and still works.

# Message language: en (default) or id.
# NOTIFY_LANG=en

# ── NOTIFIER: channels ──────────────────────────────────────────────────────
# Enable Telegram, Slack, or both. At least one is required.
# Telegram needs BOTH token and chat id, or neither.
TELEGRAM_BOT_TOKEN=123456:replace-with-real-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# Optional: forum topic ID inside the chat.
# TELEGRAM_MESSAGE_THREAD_ID=123

# Slack incoming webhook. Must be https://.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-with-real-webhook

# ── NOTIFIER: optional ──────────────────────────────────────────────────────
# The sent-MR history is notified.sqlite3 in the working directory (/data in Docker).
# Simulate a reopen notification for one MR/PR without a severity, format
# repo_id:iid (GitLab project ID or GitHub repository ID). Leave unset in normal use.
# REOPEN_TEST_MR=316:588

# ── NOT for the notifier: Renovate and webhook sync ─────────────────────────
# Set these as CI/CD variables (GitLab), Actions secrets/variables (GitHub) or
# repository variables (Bitbucket) (RENOVATE_*) or export them in your shell
# for scripts/sync_webhooks.py. Do not put the admin token in the notifier .env.
#
# RENOVATE_TEST_REPOSITORY       TESTING: one project path, e.g. frontend/dashboard.
#                                When set, Renovate and sync_webhooks.py touch only
#                                this project and ignore RENOVATE_TARGET_REPOSITORIES.
#                                Unset it to go live.
RENOVATE_TEST_REPOSITORY=
# RENOVATE_TARGET_REPOSITORIES   GitLab GROUP / GitHub ORG or user / Bitbucket WORKSPACE names, comma/newline-separated. Renovate
#                                runs on every active project inside each group,
#                                subgroups included. Read by config.js and
#                                sync_webhooks.py. Add a repo = nothing to change;
#                                add a group = append its name.
#   e.g. RENOVATE_TARGET_REPOSITORIES=frontend,backend
#   subgroup: RENOVATE_TARGET_REPOSITORIES=frontend,backend,platform/web
# RENOVATE_TOKEN                 Token for Renovate. GitHub: PAT or app token.
#                                Bitbucket: RENOVATE_USERNAME (Atlassian email) + RENOVATE_PASSWORD (API token).
# GITHUB_COM_TOKEN               optional, avoids GitHub API rate limits in release notes
#
# Only for scripts/sync_webhooks.py (GitLab only; it reads GITLAB_WEBHOOK_SECRET).
# GitHub and Bitbucket: create one organization/workspace webhook by hand, see README.
# CI_API_V4_URL                  e.g. https://gitlab.example.com/api/v4
# GITLAB_WEBHOOK_ADMIN_TOKEN     token with Maintainer access to every project in the groups
# NOTIFIER_WEBHOOK_URL           public HTTPS URL ending in /webhook
# GITLAB_WEBHOOK_SECRET          same value as above
